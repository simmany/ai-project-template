  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "padding": 16,
    "nodeSpacing": 42,
    "rankSpacing": 56,
    "wrappingWidth": 220
  },
  "gantt": {
    "fontSize": 14,
    "sectionFontSize": 15,
    "barHeight": 26,
    "barGap": 6,
    "topPadding": 56,
    "leftPadding": 170,
    "rightPadding": 40,
    "gridLineStartPadding": 40,
    "numberSectionStyles": 3
  }
}
