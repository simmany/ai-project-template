{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Pretendard, 'Apple SD Gothic Neo', 'Noto Sans KR', 'Malgun Gothic', sans-serif",
    "fontSize": "16px",
    "primaryColor": "#E9EDF3",
    "primaryTextColor": "#1B2A4A",
    "primaryBorderColor": "#1B2A4A",
    "secondaryColor": "#DCEEF5",
    "secondaryTextColor": "#14506A",
    "secondaryBorderColor": "#2E86AB",
    "tertiaryColor": "#FFFFFF",
    "tertiaryTextColor": "#1B2A4A",
    "tertiaryBorderColor": "#C3C9D4",
    "lineColor": "#5B6B82",
    "textColor": "#1B2A4A",
    "clusterBkg": "#F6F8FB",
    "clusterBorder": "#C3C9D4",
    "edgeLabelBackground": "#FFFFFF",
    "noteBkgColor": "#FFF4EE",
    "noteBorderColor": "#F26B38",
    "noteTextColor": "#1B2A4A",
    "taskBkgColor": "#2E86AB",
    "taskBorderColor": "#14506A",
    "taskTextColor": "#FFFFFF",
    "taskTextLightColor": "#FFFFFF",
    "taskTextOutsideColor": "#1B2A4A",
    "activeTaskBkgColor": "#F26B38",
    "activeTaskBorderColor": "#C4511F",
    "doneTaskBkgColor": "#C3C9D4",
    "doneTaskBorderColor": "#8C96A8",
    "critBkgColor": "#C8553D",
    "critBorderColor": "#7A2E20",
    "sectionBkgColor": "#F6F8FB",
    "altSectionBkgColor": "#FFFFFF",
    "sectionBkgColor2": "#EEF2F7",
    "gridColor": "#E1E5EC",
    "todayLineColor": "#F26B38"
